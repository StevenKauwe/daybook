+
+impl RecoverySource {
+    async fn load_cpu(&self, max_samples: usize) -> Result<Family> {
+        match self {
+            Self::Memory(source) => Family::load(source, Target::Cpu, max_samples).await,
+            Self::Reload(reload) => {
+                let source = gguf::Gguf::from_bytes(reload()?)?;
+                Family::load(&source, Target::Cpu, max_samples).await
+            }
+        }
+    }
 }
 
