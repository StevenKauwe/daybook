+    #[test]
+    #[ignore = "requires Metal, DAYBOOK_RECOVERY_MODEL and an existing speech fixture"]
+    fn file_recovery_replays_streaming_audio_after_device_loss() {
+        use std::sync::{Arc, atomic::AtomicUsize};
+        let file = std::path::PathBuf::from(std::env::var("DAYBOOK_RECOVERY_MODEL").unwrap());
+        let fixtures = std::path::PathBuf::from(std::env::var("SPEECHWORKS_TEST_MODELS").unwrap());
+        let mut wav = hound::WavReader::open(fixtures.join("jfk.wav")).unwrap();
+        let pcm: Vec<f32> = wav.samples::<i16>().take(64_000)
+            .map(|s| s.unwrap() as f32 / 32768.).collect();
+        assert_eq!(pcm.len(), 64_000);
+        let calls = Arc::new(AtomicUsize::new(0));
+        let count = Arc::clone(&calls);
+        let source = file.clone();
+        let model = pollster::block_on(Model::from_bytes(std::fs::read(&file).unwrap(), Backend::Auto))
+            .unwrap().with_recovery_loader(move || {
+                count.fetch_add(1, Ordering::SeqCst);
+                std::fs::read(&source).map_err(|e| Error::Model(e.to_string()))
+            });
+        assert!(model.is_streaming());
+        assert_eq!(model.device().unwrap().api, Api::Metal);
+        let mut state = StreamState::new();
+        pollster::block_on(model.transcribe_chunk(&mut state, &pcm[..32_000], false)).unwrap();
+        assert_eq!(calls.load(Ordering::SeqCst), 0);
+        model.model.lock().unwrap().destroy_gpu_for_test();
+        let recovered = pollster::block_on(model.transcribe_chunk(&mut state, &pcm[32_000..], true)).unwrap();
+        assert_eq!(calls.load(Ordering::SeqCst), 1);
+        assert_eq!(state.samples(), pcm.len());
+        assert!(state.is_finished() && model.fallback_reason().is_some());
+        assert_eq!(model.device().unwrap().api, Api::Cpu);
+        assert!(!recovered.text.trim().is_empty());
+        drop(model);
+        let reference = pollster::block_on(Model::from_bytes(std::fs::read(file).unwrap(), Backend::Cpu)).unwrap();
+        let expected = pollster::block_on(reference.transcribe_chunk(&mut StreamState::new(), &pcm, true)).unwrap();
+        assert_eq!(recovered.text, expected.text);
     }
